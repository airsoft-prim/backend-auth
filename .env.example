# Пример переменных окружения backend-auth.
#
# Значения совпадают с дефолтами из src/core/configs/* и с настройками docker-compose
# (профиль dev), поэтому файл годится как отправная точка для локального запуска.
# Реальные пароли, ключи и прочие секреты в репозиторий НЕ попадают: .env в .gitignore.
#
# Сервис читает переменные окружения процесса; env_file в конфигурации не задан,
# поэтому сам .env не загружается — переменные нужно экспортировать в оболочке или
# передать контейнеру.

# --- Приложение -----------------------------------------------------------------
# Имя сервиса: заголовок OpenAPI и claim iss access-токена.
APP_NAME="Auth Server"
# Название проекта: заголовок OpenAPI и claim aud access-токена.
APP_PROJECT="Airsoft Prim"
# Отладка: SQL-запросы в логах (echo) и авто-перезапуск uvicorn при изменении кода.
APP_DEBUG=false

# --- PostgreSQL -----------------------------------------------------------------
# DSN собирается как postgresql+asyncpg://USER:PSWD@HOST:PORT/NAME.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=username
DATABASE_PSWD=password
DATABASE_NAME=database

# --- Redis ----------------------------------------------------------------------
CACHE_HOST=localhost
CACHE_PORT=6379
# Логическая БД Redis для данных приложения (публичные JWK хранятся отдельно, в БД 1).
CACHE_DB=0
# Учётные данные нужны только для Redis с AUTH; если их нет, оставьте строки
# закомментированными, чтобы осталось значение None, а не пустая строка.
# CACHE_USER=
# CACHE_PSWD=

# --- Ключи подписи (EdDSA / Ed25519) --------------------------------------------
# Cron-правило ротации приватного ключа: «минута час день месяц день_недели».
SECURITY_KEY_ROTATION_RULE="0 3 1 * *"
# true — генерировать новый ключ при каждом старте, даже если файл уже существует.
SECURITY_KEY_OVERWRITE_ON_RESTART=false
# Каталог с ключом private-jwk.pem: в контейнере это volume signing-keys,
# при локальном запуске укажите собственный путь.
SECURITY_KEY_STORE_DIRECTORY=/var/lib/app/keys
# Срок жизни access-токена в секундах. По умолчанию 24 часа.
SECURITY_ACCESS_TOKEN_TTL=86400

# --- Alembic --------------------------------------------------------------------
# Нужна только миграциям (migrations/env.py), приложение её не читает.
ALEMBIC_URI=postgresql+asyncpg://username:password@localhost:5432/database
